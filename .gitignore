!/input/**/.gitkeep
/旁白/**
!/旁白/.gitkeep
/视频/**
!/视频/.gitkeep
/output/**
!/output/.gitkeep
/scratch/**
!/scratch/.gitkeep
/参考资料/**
!/参考资料/.gitkeep

